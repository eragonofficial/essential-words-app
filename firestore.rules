rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidUnitProgress(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.bookNumber is int && data.bookNumber >= 1 && data.bookNumber <= 4 &&
             data.unitNumber is int && data.unitNumber >= 1 && data.unitNumber <= 30 &&
             data.isUnlocked is bool &&
             data.isPassed is bool &&
             (!('score' in data) || (data.score is int && data.score >= 0 && data.score <= 100)) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidWordProgress(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.wordId is int &&
             data.word is string && data.word.size() <= 100 &&
             data.isLearned is bool &&
             (!('bookNumber' in data) || (data.bookNumber is int && data.bookNumber >= 1 && data.bookNumber <= 4)) &&
             (!('unitNumber' in data) || (data.unitNumber is int && data.unitNumber >= 1 && data.unitNumber <= 30)) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'displayName', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId);

      match /progress/{progressId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(progressId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'bookNumber', 'unitNumber', 'isUnlocked', 'isPassed']) &&
                         incoming().keys().hasOnly(['userId', 'bookNumber', 'unitNumber', 'isUnlocked', 'isPassed', 'score', 'updatedAt']) &&
                         isValidUnitProgress(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(progressId) &&
                         incoming().userId == existing().userId &&
                         incoming().bookNumber == existing().bookNumber &&
                         incoming().unitNumber == existing().unitNumber &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['isUnlocked', 'isPassed', 'score', 'updatedAt']) &&
                         isValidUnitProgress(incoming());

        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(progressId);
      }

      match /words/{wordId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(wordId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'wordId', 'word', 'isLearned']) &&
                         incoming().keys().hasOnly(['userId', 'wordId', 'word', 'isLearned', 'bookNumber', 'unitNumber', 'updatedAt']) &&
                         isValidWordProgress(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(wordId) &&
                         incoming().userId == existing().userId &&
                         incoming().wordId == existing().wordId &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['isLearned', 'updatedAt']) &&
                         isValidWordProgress(incoming());

        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(wordId);
      }
    }
  }
}
